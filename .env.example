# KellyOS — Firebase Auth + backend
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only Firestore Admin (never prefix with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
# Option A: absolute or repo-relative path to the service-account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=.firebase/your-project-firebase-adminsdk.json
# Option B: inline JSON string (avoid if possible; prefer PATH)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option C: standard Google ADC path
# GOOGLE_APPLICATION_CREDENTIALS=

# true  = local JSON document store (data/kellyos-store.json)
# false = live Cloud Firestore (requires Admin credentials above)
USE_DEMO_FIRESTORE=false

# true = CSR project reads from localDemoProjects / localStorage (bypass Firestore Project reads)
NEXT_PUBLIC_LOCAL_DEMO_MODE=true

OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
USE_DEMO_AI=true
NEXT_PUBLIC_APP_NAME=KellyOS
NEXT_PUBLIC_DEMO_MODE=true
DEMO_EMAIL=demo@kellyos.ai
DEMO_PASSWORD=demo123
UPLOAD_DIR=./uploads
